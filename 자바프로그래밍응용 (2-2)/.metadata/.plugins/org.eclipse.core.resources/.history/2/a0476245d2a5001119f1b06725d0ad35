}

class FeaturesInfo {
	public String seating;
	/** 단위는 입방피트(ft^3)임 */
	public int capacity;
	/** 단위는 입방피트(ft^3)임 */
	public int cargoSize;
	
	public FeaturesInfo(String seating, int capacity, int cargoSize) {
		this.seating = seating;
		this.capacity = capacity;
		this.cargoSize = cargoSize;
	}
}

