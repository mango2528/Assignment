public abstract class Vehicle {
	final static String[] vehicles = {"자동차", "비행기", "배"}; 
	
	String vehicleName;
	String activityRange;
	
	abstract void generateProductName();
	
	abstract void setActivityRange();
	
	public abstract String toString();
}

interface Product {
	void printInfo();
}

class FeaturesInfo {
	public String seating;
	/** 단위는 입방피트(ft^3)임 */
	public int capacity;
	/** 단위는 입방피트(ft^3)임 */
	public int cargoSize;
	
	public FeaturesInfo(String seating, int capacity, int cargoSize) {
		this.seating = seating;
		this.capacity = capacity;
		this.cargoSize = cargoSize;
	}
}

class Sedan extends Vehicle implements PowerSource, Feature{
	protected String productName;
	
	@Override
	public void generateProductName() {
		
	}
	
	@Override
	public void setActivityRange() {
		
	}
	
	@Override
	public String toString() {
		return String.format("| %s - %s는 %s에서 활동합니다.| 세단(%s) | 동력원 : %s | 좌석 유형 : %s | 적재 용량 : %d | 짐칸 크기 : %d |",
				this.vehicleName, this.vehicleName, this.activityRange ,productName, generatePowerSource(), generateSeating(), generateCapacity(), generateSize());
	}
	
	@Override
	public String generatePowerSource() {
		String[] powerSources = {"가솔린", "디젤", "전기"};
		
		return powerSources[Random.random(0, powerSources.length - 1)];
	}

	@Override
	public String generateSeating() {
		String[] seatingType = {"버켓", "벤치", "분할 벤치"};
		
		return seatingType[Random.random(0, seatingType.length - 1)];
	}

	@Override
	public int generateCapacity() {
		return Random.random(13, 17);
	}

	@Override
	public int generateSize() {
		return Random.random(12, 16);
	}
}

